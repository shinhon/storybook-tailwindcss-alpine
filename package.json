    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "alpinejs": "^3.17.1"
  }
}
