{
  "name": "storybook-tailwindcss-alpine",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "tokens:build": "style-dictionary build --config style-dictionary.config.js",
